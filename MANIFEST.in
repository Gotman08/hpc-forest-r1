include README.md AGENTS.md CHANGELOG.md
include requirements-*.lock
include docs/ARCHITECTURE.md docs/APPLICATION.md docs/MIGRATION-0.2.md docs/SECURITY.md docs/DISTRIBUTION.md docs/THIRD-PARTY-NOTICES.md
include docs/romeo.example.json
include docs/dependencies-*.json
recursive-include configs *.toml
recursive-include scripts *.ps1
recursive-include src/hpc_forest/webapp/static *.html *.css *.mjs *.svg
recursive-include src/hpc_forest/assets *
prune experiments
prune evidence
prune artifacts
prune work
prune tests
prune build
prune dist
global-exclude __pycache__ *.py[cod] *.sqlite3 *.zip .env authorization.json
