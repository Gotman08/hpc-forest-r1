+__device__ __forceinline__ float inverseDistanceCubed(float distSq) {
+    float invDist = rsqrtf(distSq);
+    const float halfDistSq = 0.5f * distSq;
+    invDist *= 1.5f - halfDistSq * invDist * invDist;
+    invDist *= 1.5f - halfDistSq * invDist * invDist;
+    return invDist * invDist * invDist;
+}
