@@ -12,6 +12,36 @@ struct SourceParticle {
 
 static constexpr int SOURCE_TILE_SIZE = 256;
 
+__device__ __forceinline__ void accumulate_source_force(
+    const Particle& target,
+    const SourceParticle& source,
+    float G,
+    float softening,
+    float& fx,
+    float& fy,
+    float& fz) {
+    const float dx = source.x - target.x;
+    const float dy = source.y - target.y;
+    const float dz = source.z - target.z;
+
+    const float distSq = dx * dx + dy * dy + dz * dz + softening;
+    const float invDist = rsqrtf(distSq);
+    float invDistCube;
+    if (invDist == 0.0f) {
+        invDistCube = 0.0f;
+    } else {
+        const float invDistSq = invDist * invDist;
+        const float squareError = fmaf(distSq, invDistSq, -1.0f);
+        const float cubeCorrection = fmaf(-1.5f, squareError, 1.0f);
+        invDistCube = (invDistSq * invDist) * cubeCorrection;
+    }
+
+    const float f = (G * target.mass * source.mass) * invDistCube;
+    fx += f * dx;
+    fy += f * dy;
+    fz += f * dz;
+}
