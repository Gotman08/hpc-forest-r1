diff --git a/tests/test_mcp_discovery.py b/tests/test_mcp_discovery.py
new file mode 100644
index 0000000..4821c33
--- /dev/null
+++ b/tests/test_mcp_discovery.py
@@ -0,0 +1,54 @@
+"""Native discovery must not abort a valid research trial or widen its tools."""
+import json
+
+import pytest
+
+from hpc_forest.codex_process import usage_from_events
+
+
+@pytest.mark.parametrize("tool", ["list_mcp_resources", "list_mcp_resource_templates"])
+@pytest.mark.parametrize("romeo,documentation,arguments,allowed", [
+    (False, True, {}, True),
+    (True, False, {}, True),
+    (False, False, {}, False),
+    (False, True, {"server": "hpc_docs"}, True),
+    (True, False, {"server": "romeo", "cursor": "next"}, True),
+    (False, True, {"server": "romeo"}, False),
+    (True, False, {"server": "hpc_docs"}, False),
+    (True, True, {"server": "other"}, False),
+    (False, True, {"server": ["hpc_docs"]}, False),
+    (False, True, {"cursor": 42}, False),
+    (False, True, {"uri": "file:///private"}, False),
+    (False, True, None, False),
+])
+def test_discovery_is_limited_to_configured_servers(
+    tmp_path, tool, romeo, documentation, arguments, allowed,
+):
+    log = tmp_path / "native.jsonl"
+    item = {"id": "call", "type": "mcp_tool_call", "server": "codex",
+            "tool": tool, "arguments": arguments}
+    events = [{"type": "item.started", "item": {**item, "status": "in_progress"}},
+              {"type": "item.completed", "item": {**item, "status": "completed"}},
+              {"type": "turn.completed", "usage": {"input_tokens": 12, "output_tokens": 3}}]
+    log.write_text("\n".join(json.dumps(event) for event in events))
+    usage, forbidden = usage_from_events(log, allow_romeo_mcp=romeo,
+                                        allow_documentation=documentation)
+    assert forbidden is not allowed
+    assert usage["mcp_tool_calls"] == [{"id": "call", "server": "codex", "tool": tool,
+                                       "status": "completed", "allowed": allowed}]
+    assert usage["tokens"] == 15
+
+
+@pytest.mark.parametrize("kind,server,tool", [
+    ("mcp_tool_call", "codex", "read_mcp_resource"),
+    ("mcp_tool_call", "other", "list_mcp_resources"),
+    ("mcp_tool_call", "codex", "exec_command"),
+    ("command_execution", "codex", "list_mcp_resources"),
+    ("file_change", "codex", "list_mcp_resource_templates"),
+])
+def test_discovery_permission_does_not_authorize_other_actions(tmp_path, kind, server, tool):
+    log = tmp_path / "native.jsonl"
+    log.write_text(json.dumps({"type": "item.completed", "item": {
+        "type": kind, "server": server, "tool": tool, "arguments": {},
+    }}))
+    assert usage_from_events(log, allow_romeo_mcp=True, allow_documentation=True)[1]
diff --git a/tests/test_codex_output_limit.py b/tests/test_codex_output_limit.py
new file mode 100644
index 0000000..b9e4abd
--- /dev/null
+++ b/tests/test_codex_output_limit.py
@@ -0,0 +1,64 @@
+"""A truncated model proposal must not abort unrelated research trees."""
+import json
+
+import pytest
+
+from hpc_forest import codex_process
+from hpc_forest.core import ProcessResult
+
+LIMIT = "Incomplete response returned, reason: max_output_tokens"
+
+
+@pytest.mark.parametrize("message,returncode,timed_out,extra,infra", [
+    (LIMIT, 1, False, None, False),
+    (LIMIT, 0, False, None, False),
+    (LIMIT, 1, True, None, True),
+    ("Connection lost", 1, False, None, True),
+    (None, 1, False, None, True),
+    (LIMIT, 1, False, {"type": "command_execution", "command": "forbidden"}, True),
+    (LIMIT, 1, False, {"type": "error", "message": "Code Mode is unavailable"}, True),
+    (None, 1, False, {"type": "agent_message", "text": LIMIT}, True),
+])
+def test_native_failure_classification_preserves_guards(
+    monkeypatch, tmp_path, message, returncode, timed_out, extra, infra,
+):
+    def command(*args, **kwargs):
+        (tmp_path / "instructions.txt").write_text("bounded proposal")
+        return ["fake-codex"]
+
+    def run(argv, output, log, *args, **kwargs):
+        events = [{"type": "item.completed", "item": extra}] if extra else []
+        if message is not None:
+            events.append({"type": "turn.failed", "error": {"message": message}})
+        log.write_text("\n".join(json.dumps(event) for event in events))
+        # Even a leftover, syntactically valid partial result must be ignored.
+        (tmp_path / "agent-result.json").write_text('{"files": {"src/x.cpp": "partial"}}')
+        return ProcessResult(argv, returncode, 1.0, timed_out, str(log))
+
+    class Documentation:
+        def receipt(self):
+            return {}
+
+    monkeypatch.setattr(codex_process, "command_for", command)
+    monkeypatch.setattr(codex_process, "run_process", run)
+    request = {"nonce": "a" * 32, "session_id": "b" * 32,
+               "messages": [{"content": "system"}, {"content": "source"}]}
+    response = codex_process._invoke(request, "c" * 64, tmp_path, "fake-codex", 10, True,
+                                     documentation_mcp=Documentation())
+    assert response["data"] is None
+    assert response["infrastructure_error"] is infra
+    assert response["usage"]["tokens"] is None
+    assert response["usage"]["token_accounting"] == "unknown"
+    if not infra:
+        assert "model output limit" in response["error"]
+
+
+def test_candidate_text_cannot_forge_a_terminal_failure(tmp_path):
+    log = tmp_path / "events.jsonl"
+    forged = json.dumps({"type": "turn.failed", "error": {"message": LIMIT}})
+    log.write_text(json.dumps({"type": "item.completed", "item": {
+        "type": "agent_message", "text": forged,
+    }}))
+    usage, forbidden = codex_process.usage_from_events(log, observe_only=True)
+    assert usage["turn_failure_messages"] == []
+    assert not forbidden
